// generator client
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enumerações (Refletindo a State Machine) ---

enum OrderStatus {
  DRAFT
  MEASURING
  CUTTING
  STITCHING
  TRIAL
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}


model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  password_hash String
  role          String   @default("STAFF") // Ex: ADMIN, STAFF
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model Client {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  phone        String
  document     String?       @unique // CPF/CNPJ
  createdAt    DateTime      @default(now())
  
  // Relações
  orders       Order[]
  measurements Measurement[] // Histórico de medidas

  @@map("clients")
}

model Measurement {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  
  neck      Float?
  chest     Float?
  waist     Float?
  sleeve    Float?
  length    Float?
  
  observations String? @db.Text
  createdAt    DateTime @default(now()) // Isso garante o histórico imutável

  @@map("measurements")
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  contact   String?
  category  String?   
  products  Product[]

  @@map("suppliers")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  
  orderItems  OrderItem[]

  @@map("products")
}

model Order {
  id           String      @id @default(uuid())
  status       OrderStatus @default(DRAFT)
  totalValue   Decimal     @db.Decimal(10, 2)
  
  // Datas de controle de alfaiataria
  trialDate    DateTime?   // Data da prova
  deliveryDate DateTime?   // Data de entrega prometida
  
  // Relações
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  items        OrderItem[]
  payments     Payment[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2) // Preço no momento da venda (snapshot)

  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  method         String        // PIX, CARD, CASH
  installments   Int           @default(1) // Parcelas
  transactionId  String?       // ID externo do gateway de pagamento
  
  createdAt      DateTime      @default(now())

  @@map("payments")
}